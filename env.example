# 复制：cp env.example .env  再填 WSKEY

# 必填：京东云无线宝 APP 抓包 wskey（见 README）
WSKEY=

# 轮询秒数
POLL_INTERVAL=45

# 连续 miss 几次记离线
OFFLINE_MISSES=2

# 只监控这些客户端 MAC（完整或后6位），逗号分隔；空=全部
# WATCH_MACS=aa:bb:cc:dd:ee:ff,112233
WATCH_MACS=

# 只查这些路由器 MAC；空=账号下全部
# ROUTER_MACS=AA:BB:CC:DD:EE:FF
ROUTER_MACS=

# 可选：出网代理
# HTTP_PROXY=http://proxy:port
# HTTPS_PROXY=http://proxy:port

# 网页登录密码（空=不启用登录；也可在网页「设置」里改）
# UI_PASSWORD=your-password
UI_PASSWORD=

# Cookie 签名盐（改密码会自动换会话；一般不用动）
# SESSION_SECRET=random-long-string
